#!/usr/bin/env bash
# ==============================================================================
# Modem Kit v3 — PC CLI Controller & Debugger
# ==============================================================================
# Remote command-line interface for controlling Modem Kit on rooted Pixel 2 XL
# (Android 15 Evolution X / Qualcomm MSM8998) over adb.
# ==============================================================================

set -eo pipefail

ADB="${ADB:-adb}"
TARGET_PKG="com.minebutt.modemkit"
RECEIVER="$TARGET_PKG/.CliReceiver"
ACTION="com.minebutt.modemkit.CLI"
TMP_DIR="/data/local/tmp"

# Colors
C_BOLD="\033[1m"
C_GREEN="\033[32m"
C_CYAN="\033[36m"
C_YELLOW="\033[33m"
C_RED="\033[31m"
C_RESET="\033[0m"

die() {
    echo -e "${C_RED}Error:${C_RESET} $*" >&2
    exit 1
}

check_device() {
    if ! "$ADB" get-state >/dev/null 2>&1; then
        die "No adb device attached or authorized. Run '$ADB devices' to check."
    fi
}

shq() {
    printf "'%s'" "${1//\'/\'\\\'\'}"
}

send_cmd() {
    local cmd="$1"
    shift
    local extras=("$@")

    # Remove previous output file
    "$ADB" shell su -c "rm -f $TMP_DIR/modemkit.out" >/dev/null 2>&1 || true

    # Send broadcast to CliReceiver
    local line="am broadcast -a $ACTION -n $RECEIVER --es cmd $(shq "$cmd")"
    local a
    for a in "${extras[@]}"; do line+=" $(shq "$a")"; done
    "$ADB" shell "$line" >/dev/null 2>&1 || true
    
    # Wait for output file (up to 15s)
    local i=0
    while [ $i -lt 30 ]; do
        sleep 0.4
        i=$((i + 1))
        local exists
        exists=$("$ADB" shell su -c "[ -f $TMP_DIR/modemkit.out ] && echo yes || echo no" 2>/dev/null | tr -d '\r\n')
        if [ "$exists" = "yes" ]; then
            break
        fi
    done

    local out
    out=$("$ADB" shell su -c "cat $TMP_DIR/modemkit.out 2>/dev/null" || true)
    if [ -n "$out" ]; then
        echo "$out"
    else
        echo "(no response received from app within timeout)"
    fi
}

usage() {
    echo -e "${C_BOLD}Modem Kit v3 — PC Command Line Interface${C_RESET}"
    echo
    echo "Usage: ./modemkit-cli <command> [arguments...]"
    echo
    echo -e "${C_BOLD}Commands:${C_RESET}"
    echo -e "  ${C_CYAN}status${C_RESET}                 Show full live radio status, active bands, cell & health"
    echo -e "  ${C_CYAN}cell${C_RESET}                   Perform cell scan (NAS Get Cell Loc: serving & neighbors)"
    echo -e "  ${C_CYAN}bands${C_RESET}                  Show enabled bands, saved baseline original bands & mode"
    echo -e "  ${C_CYAN}lock <bands> [--perm]${C_RESET}  Lock modem to comma-separated bands (e.g. lock 3,7,20)"
    echo -e "  ${C_CYAN}restore [--perm]${C_RESET}       Restore modem original baseline bands (qband.orig)"
    echo -e "  ${C_CYAN}mode <auto|lte|3g2g>${C_RESET}  Change network RAT mode preference"
    echo -e "  ${C_CYAN}ip${C_RESET}                     Show mobile IP interfaces and connection state"
    echo -e "  ${C_CYAN}logs${C_RESET}                   Dump recent in-app activity and diagnostic logs"
    echo -e "  ${C_CYAN}report${C_RESET}                 Generate and display complete bug report snapshot"
    echo -e "  ${C_CYAN}poll${C_RESET}                   Trigger immediate background polling cycle in app"
    echo -e "  ${C_CYAN}prepare${C_RESET}                Verify/re-install helper wrappers & modem libraries"
    echo -e "  ${C_CYAN}raw <cmd>${C_RESET}              Execute arbitrary root command on the device"
    echo -e "  ${C_CYAN}scan --yes${C_RESET}             Scan this location: all bands on for ~45 s, then the lock is put back"
    echo -e "  ${C_CYAN}local${C_RESET}                  Last location scan, bands found here, and the settings that use them"
    echo -e "  ${C_CYAN}seen${C_RESET}                   Cells this phone has measured, what the last scan missed, and serving towers"
    echo -e "  ${C_CYAN}setting [name on|off]${C_RESET}  Show or change show_theory / show_local (no arguments: show both)"
    echo
}

check_device

CMD="${1:-status}"
shift || true

case "$CMD" in
    status)
        echo -e "${C_BOLD}Fetching Modem Kit Status...${C_RESET}"
        send_cmd "status"
        ;;
    cell)
        echo -e "${C_BOLD}Scanning LTE Cells (NAS Get Cell Location)...${C_RESET}"
        send_cmd "cell"
        ;;
    bands)
        echo -e "${C_BOLD}Querying Modem Band Configuration...${C_RESET}"
        send_cmd "bands"
        ;;
    lock)
        BANDS="$1"
        [ -z "$BANDS" ] && die "Usage: ./modemkit-cli lock <bands> (e.g. lock 3,7,20 [--perm])"
        PERM="false"
        [ "$2" = "--perm" ] && PERM="true"
        echo -e "${C_BOLD}Locking bands to: $BANDS (permanent=$PERM)...${C_RESET}"
        send_cmd "set_bands" --es bands "$BANDS" --ez perm "$PERM"
        ;;
    restore)
        PERM="false"
        [ "$1" = "--perm" ] && PERM="true"
        echo -e "${C_BOLD}Restoring original baseline bands (permanent=$PERM)...${C_RESET}"
        send_cmd "restore_bands" --ez perm "$PERM"
        ;;
    mode)
        MODE="$1"
        [ -z "$MODE" ] && die "Usage: ./modemkit-cli mode <auto|lte|3g2g> [--perm]"
        PERM="false"
        [ "$2" = "--perm" ] && PERM="true"
        echo -e "${C_BOLD}Setting network mode to: $MODE (permanent=$PERM)...${C_RESET}"
        send_cmd "set_mode" --es mode "$MODE" --ez perm "$PERM"
        ;;
    ip)
        echo -e "${C_BOLD}Active Mobile IP Addresses:${C_RESET}"
        "$ADB" shell su -c "ip -o -4 addr show | grep -E 'rmnet|pdp' || ip -o -4 addr show"
        ;;
    target-ip)
        IP="$1"
        [ -z "$IP" ] && die "Usage: ./modemkit-cli target-ip <ip-address>"
        echo -e "${C_BOLD}Setting target IP to: $IP...${C_RESET}"
        send_cmd "set_target_ip" --es ip "$IP"
        ;;
    hook)
        STATE="$1"
        shift || true
        [ -z "$STATE" ] && die "Usage: ./modemkit-cli hook <on|off> [--reason 1|2|3] [--addr <ip>] [--apn <filter>]"
        ON="false"
        [ "$STATE" = "on" ] && ON="true"
        REASON=""
        ADDR=""
        APN=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --reason) REASON="$2"; shift 2 ;;
                --addr) ADDR="$2"; shift 2 ;;
                --apn) APN="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        echo -e "${C_BOLD}Updating LSPosed hook (on=$ON reason='$REASON' addr='$ADDR' apn='$APN')...${C_RESET}"
        send_cmd "hook" --ez on "$ON" --es reason "$REASON" --es addr "$ADDR" --es apn "$APN"
        ;;
    scan)
        YES="false"
        [ "$1" = "--yes" ] && YES="true"
        echo -e "${C_BOLD}Location scan...${C_RESET}"
        send_cmd "scan" --ez yes "$YES"
        ;;
    local)
        send_cmd "local"
        ;;
    seen)
        send_cmd "seen"
        ;;
    setting)
        send_cmd "setting" --es key "${1:-}" --es value "${2:-}"
        ;;
    logs)
        send_cmd "logs"
        ;;
    report)
        echo -e "${C_BOLD}Generating Full Diagnostic Report...${C_RESET}"
        send_cmd "report"
        ;;
    poll)
        echo -e "${C_BOLD}Triggering app poll cycle...${C_RESET}"
        send_cmd "poll"
        ;;
    prepare)
        echo -e "${C_BOLD}Preparing helper wrappers and vendor libraries...${C_RESET}"
        send_cmd "prepare"
        ;;
    raw|exec)
        [ -z "$1" ] && die "Usage: ./modemkit-cli raw \"<command>\""
        send_cmd "exec" --es exec "$*"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage
        die "Unknown command: $CMD"
        ;;
esac
